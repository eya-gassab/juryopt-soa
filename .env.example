# Copier ce fichier en .env et adapter les valeurs (le vrai .env n'est jamais commité)
POSTGRES_USER=juryopt
POSTGRES_PASSWORD=change_me

DEFENSE_DB=defense_db
OPTIMIZER_DB=optimizer_db
REGISTRAR_DB=registrar_db

# Hôtes internes Docker Compose (les défauts locaux restent localhost dans application.yml)
ORCHESTRATOR_SERVICE_URL=http://defense-orchestrator-service:8081
SOAP_SERVICE_URL=http://registrar-clearance-service:8083/ws
GRPC_OPTIMIZER_HOST=schedule-optimizer-service
GRPC_OPTIMIZER_PORT=9090