{
  "info": {
    "name": "JuryOpt SOA - Demo Soutenance (Gateway :8080)",
    "description": "Collection de demonstration JuryOpt via api-gateway (:8080). Executer les dossiers dans l'ordre 01 -> 06 sur des bases propres (apres `docker compose down -v && docker compose up -d`). Suivre les consignes `docker compose stop` / `start` indiquees dans les dossiers 03, 05 et 06.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "defense1Id", "value": "" },
    { "key": "defense2Id", "value": "" },
    { "key": "defense3Id", "value": "" },
    { "key": "fallbackScheduleId", "value": "" },
    { "key": "draftScheduleId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Supervision & Contrats (Gateway)",
      "description": "Verification de la sante de la Gateway, des Circuit Breakers de l'orchestrateur et du contrat OpenAPI via le port unique 8080.",
      "item": [
        {
          "name": "01.1 - Health API Gateway (200 UP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Gateway UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "01.2 - Health Orchestrateur & Circuit Breakers (200 UP / CLOSED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Orchestrateur UP', () => pm.expect(body.status).to.eql('UP'));",
                  "pm.test('Circuit Breakers CLOSED', () => {",
                  "  pm.expect(body.components.circuitBreakers.details.registrarSoap.details.state).to.eql('CLOSED');",
                  "  pm.expect(body.components.circuitBreakers.details.optimizerGrpc.details.state).to.eql('CLOSED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ops/orchestrator/health",
              "host": ["{{baseUrl}}"],
              "path": ["ops", "orchestrator", "health"]
            }
          }
        },
        {
          "name": "01.3 - Contrat OpenAPI YAML via Gateway (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Serveur expose :8080', () => pm.expect(pm.response.text()).to.include('localhost:8080'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs.yaml",
              "host": ["{{baseUrl}}"],
              "path": ["v3", "api-docs.yaml"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Nominal SOAP & Erreurs (400 / 404 / 409 / 422)",
      "description": "Creation d'un etudiant eligible (ETU-2026-001), mise a jour sans perte de clearance, puis validation des erreurs 400, 404, 409 et 422 sans ouvrir le Circuit Breaker.",
