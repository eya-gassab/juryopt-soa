          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentMatricule\": \"ETU-2026-001\",\n  \"projectTitle\": \"Plateforme SOA de planification des soutenances\",\n  \"supervisorCode\": \"PROF-01\",\n  \"presidentCode\": \"PROF-02\",\n  \"rapporteurCode\": \"PROF-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/defenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "defenses"]
