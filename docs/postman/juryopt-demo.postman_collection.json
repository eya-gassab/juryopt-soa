        {
          "name": "02.1 - Creer demande eligible ETU-2026-001 (201 ELIGIBLE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location en :8080', () => pm.expect(pm.response.headers.get('Location')).to.include('localhost:8080/api/v1/defenses/'));",
                  "const body = pm.response.json();",
                  "pm.test('Statut ELIGIBLE + token CLR', () => {",
                  "  pm.expect(body.status).to.eql('ELIGIBLE');",
                  "  pm.expect(body.studentName).to.eql('Amine Ben Salem');",
                  "  pm.expect(body.clearanceToken).to.match(/^CLR-/);",
                  "});",
                  "pm.collectionVariables.set('defense1Id', body.id);"
